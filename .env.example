# GrantThrive Backend — Environment Variables
# ===========================================
# Copy to .env and fill in. This file lists every variable the backend reads.
# Never commit .env — it holds secrets.
#
# Generate a random secret (SECRET_KEY, *_ENCRYPTION_KEY, FIELD_HMAC_KEY) with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"


# ── 1. Core (required) ────────────────────────────────────────────────────────
# Signs login tokens. The app refuses to start without it.
SECRET_KEY=""
# "development" enables developer-only features (demo login).
# Leave unset or "production" on servers.
FLASK_ENV="development"
# Public URLs: links in emails and Stripe Checkout/Portal redirects.
FRONTEND_BASE_URL="http://localhost:5173"
MARKETING_BASE_URL="https://www.grantthrive.com"
# Only needed when the frontend runs on a different origin than the API.
# Comma-separated; when unset, defaults to localhost:5173 and the grantthrive.com apps.
# CORS_ORIGINS="http://localhost:5173"


# ── 2. Database — PostgreSQL (required) ───────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://grantthrive:password@localhost:5432/grantthrive_dev"
# Used only by the automated test suite (pytest).
TEST_DATABASE_URL="postgresql://grantthrive:password@localhost:5432/grantthrive_test"


# ── 3. Encryption (required in production) ────────────────────────────────────
# AES-256-GCM encryption of personal data (email, phone, address, ABN) and the
# HMAC key for searching encrypted emails. Without them, PII is stored in
# plaintext (development only). Changing them makes existing data unreadable.
FIELD_ENCRYPTION_KEY=""
FIELD_HMAC_KEY=""
# Encrypts secrets saved through the admin dashboard.
# Saving such secrets is refused while it is unset.
SYSTEM_CONFIG_ENCRYPTION_KEY=""


# ── 4. Rate limiting (production) ─────────────────────────────────────────────
# Redis for shared rate-limit counters across workers. Unset = in-memory.
# REDIS_URL="rediss://<cluster>.cache.amazonaws.com:6380"


# ── 5. AWS — email (SES) and document storage (S3) ────────────────────────────
# With AWS_SES_ENABLED=false, emails are written to the log instead of sent.
AWS_SES_ENABLED="false"
AWS_SES_FROM_EMAIL=""          # Verified SES sender, e.g. no-reply@grantthrive.com
AWS_REGION="ap-southeast-2"    # Used by SES and S3
AWS_S3_BUCKET=""               # Required for application document uploads
# Omit both when running with an IAM role (EC2/ECS).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""


# ── 6. Public contact & waitlist forms ────────────────────────────────────────
# Cloudflare Turnstile secret (the site key goes in the frontend's VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=""
# Comma-separated hostnames Turnstile tokens must come from.
TURNSTILE_EXPECTED_HOSTNAMES="www.grantthrive.com,grantthrive.com"
# Tests only — skips Turnstile verification. Never enable on a server.
# TURNSTILE_TEST_BYPASS="false"
# Submissions are stored in the database; this address receives a content-free alert.
ADMIN_NOTIFICATION_EMAIL=""
ADMIN_DASHBOARD_URL="https://admin.grantthrive.com/admin/dashboard?tab=form-submissions"
# Refuse to store submissions when FIELD_ENCRYPTION_KEY is missing.
PUBLIC_SUBMISSION_ENCRYPTION_REQUIRED="true"


# ── 7. ABN lookup (optional) ──────────────────────────────────────────────────
# Australian Business Register web-services GUID. Unset = format-only validation.
# Register at https://abr.business.gov.au/Tools/WebServices
ABR_GUID=""


# ── 8. Billing — Stripe subscriptions ─────────────────────────────────────────
# Prepare a Stripe account once with:  STRIPE_SECRET_KEY=sk_... python scripts/stripe_setup.py
# (prints STRIPE_PORTAL_CONFIGURATION_ID). See README section 5.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint <API host>/api/billing/webhook.
# Locally: `stripe listen --forward-to localhost:5000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=""
STRIPE_PORTAL_CONFIGURATION_ID=""
