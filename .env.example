# GrantThrive Backend Environment Variables
# =========================================
# Copy this file to .env and fill in the values.

# 1. Core Flask settings
# ----------------------
# Generate a secure secret key. You can use: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=""

# Set to "development" for local work to enable debug mode and dev database
FLASK_ENV="development"

# 2. Database — PostgreSQL (required)
# ------------------------------------
# GrantThrive requires PostgreSQL for all environments. SQLite is NOT supported.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Quick local setup:
#   createdb grantthrive_dev
#   createdb grantthrive_test
#
# Production database (used when FLASK_ENV=production):
DATABASE_URL="postgresql://grantthrive:password@localhost:5432/grantthrive"

# Development database (used when FLASK_ENV=development):
DEV_DATABASE_URL="postgresql://grantthrive:password@localhost:5432/grantthrive_dev"

# Test database (used by the test suite):
TEST_DATABASE_URL="postgresql://grantthrive:password@localhost:5432/grantthrive_test"

# 3. Email (Optional - for testing registration/notification emails)
# ------------------------------------------------------------------
# If you don't have an SMTP server, you can use a service like Mailtrap.io
# or just leave these blank. The app will log emails to the console in dev mode.
MAIL_SERVER="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_DEFAULT_SENDER="" # e.g., "GrantThrive Dev <noreply@grantthrive.com>"

# 4. File Uploads & AWS S3 Storage 
# ----------------------------------
# For production on AWS, all files (documents, reports, logos) are stored in S3.
# Local disk storage is used only in development if S3 is not configured.
#
# REQUIRED for production:
AWS_S3_BUCKET="grantthrive-documents-prod"        # S3 bucket name
AWS_REGION="ap-southeast-2"                      # AWS region

# Optional explicit AWS credentials:
# When running on ECS with an IAM task role, omit these — boto3 will use the role's credentials
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Note on S3 setup:
# - Create an S3 bucket for document storage
# - Enable versioning for safety: see S3_SETUP.md
# - IAM task role should have permissions: s3:GetObject, s3:PutObject, s3:DeleteObject
# - After migrations, local UPLOAD_FOLDER is no longer used

# For development with local fallback (deprecated):
AWS_S3_USE_LOCAL_FALLBACK="false"                # Use local disk if S3 unavailable
UPLOAD_FOLDER="/tmp/grantthrive_uploads"         # Local fallback (development only)

# 5. Field-Level Encryption (REQUIRED in production)
# ---------------------------------------------------
# AES-256-GCM encryption for PII fields (email, phone, address, ABN, etc.)
# and a separate HMAC key for searchable field indexes.
#
# Generate both keys with:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# NEVER commit these values to source control.
# Store them as secrets in your deployment environment
# (AWS Secrets Manager, GitHub Actions secrets, etc.)
#
# If these are not set, the application will start but PII will be stored
# in plaintext and a WARNING will be logged. This is acceptable for local
# development only.
FIELD_ENCRYPTION_KEY=""
FIELD_HMAC_KEY=""
# 6. Twilio SMS (GrantThrive centralised account — do NOT share with councils)
# ---------------------------------------------------------------------------
# These credentials belong to GrantThrive's own Twilio account.
# Councils do not manage their own Twilio credentials.
# SMS is delivered on behalf of councils via GrantThrive's account.
#
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""     # Starts with AC...
TWILIO_AUTH_TOKEN=""      # Keep secret — never commit
TWILIO_FROM_NUMBER=""     # E.164 phone number (+61400000000) or Messaging Service SID (MG...)
